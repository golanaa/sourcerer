		(property "Manufacturer 1" "Murata" (at 269.24 60.96 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(property "Manufacturer Part Number 1" "GRM32ER72A225KA35L" (at 269.24 60.96 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(property "Operating Temperature" "-55 to +125 C" (at 269.24 60.96 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(property "Capacitance Measurement Conditions" "Room temperature; 1.0 +/-0.1 kHz; 1.0 +/-0.2 Vrms (p3)." (at 269.24 60.96 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(property "Temperature Characteristics" "+/-15% from -55 to +125 C, reference 25 C, no DC bias (pp2-3)." (at 269.24 60.96 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(property "DC Bias Limitation" "Nominal capacitance is not guaranteed at applied DC voltage; effective capacitance depends on bias, temperature and aging. No numerical bias-retention guarantee established by this reference sheet. Evaluate at actual application conditions." (at 269.24 60.96 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(property "Voltage Conditions" "Rated voltage is maximum continuous voltage. With AC superimposed on DC, V(peak-to-peak) or V(zero-to-peak), whichever larger, must remain within rated voltage (p3)." (at 269.24 60.96 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(property "Mounting" "Reflow only; evaluate actual PCB lands and solder quantity (pp2,16,27)." (at 269.24 60.96 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(property "Maximum Body Height" "2.70 mm (p2), excluding assembly allowances" (at 269.24 60.96 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(property "Packaging" "L: 180 mm reel, W8P4 plastic tape, 1000 pcs/reel" (at 269.24 60.96 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(property "Part Origin" "Exact-MPN migration research from historical P-00015 context only; no inherited verification, project edits or substitute approval. Symbol from KiCad Device:C. Reuses unchanged managed verified:C_1210_3225Metric. Provisional geometric fit only, per latest request clarification; not assembly approval or placement-tolerance analysis. Nonpolar terminals map to pads 1 and 2. Catalog pads at x +/-1.475 mm are 1.15 x 2.70 mm. At centered placement, minimum end-terminal strips at body-length extremes occupy x 1.150..1.450 and 1.450..1.750 mm (opposite terminal mirrored), within the positive pad span 0.900..2.050 mm; transverse pad width accommodates maximum 2.70 mm body width. Courtyard +/-2.30 x +/-1.60 mm surrounds maximum body +/-1.75 x +/-1.35 mm. Retained gap 1.80 mm and width 2.70 mm differ from Murata p27 recommended gap 2.0..2.4 mm and width 1.8..2.3 mm; pad length 1.15 mm is within 1.0..1.2 mm. This is NOT a manufacturer-recommended land pattern. Murata p27 requires actual PCB evaluation; p16 warns excessive solder can stress/crack MLCCs. Human exact-part review must assess this assembly deviation and solder amount before verification. Reviewed copper/mask/paste and courtyard retained unchanged; no new stencil specification or waiver. Unchanged reviewed generic STEP measured x +/-1.60, y +/-1.25, z 0..2.50 mm, matching nominal body envelope only. It does not represent tolerance extremes or exact manufacturer termination construction. Exact-part maximum height is 2.70 mm; use this, plus assembly allowances, for clearance rather than the nominal model. Generic model reuse does not qualify this MPN." (at 269.24 60.96 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(property "Package Detail" "1210 (3225 Metric), Murata GRM32E; 3.2 +/-0.3 x 2.5 +/-0.2 x 2.5 +/-0.2 mm" (at 269.24 60.96 0) (effects (font (size 1.27 1.27)) (hide yes)))
	)
