		(property "Manufacturer 1" "Vishay Dale" (at 92.71 234.95 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(property "Manufacturer Part Number 1" "TNPW0805402KBEEA" (at 92.71 234.95 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(property "Part Origin" "Exact-MPN symbol created by Steve. Reuses the unchanged reviewed OCPM managed R_0805_2012Metric footprint and generic model under the standard passive-package exception. Vishay TNPW 0805 nominal body 2.00 x 1.25 x 0.45 mm; two nonpolar terminals. Shared IPC-style lands 1.025 x 1.40 mm at X +/-0.9125 mm, gap 0.80 mm. Vishay 28950 recommends 0.90 x 1.45 mm lands with 1.00 mm gap. Existing reviewed generic 0805 package selected; dimensional differences are deliberate generic-package reuse, not a claim of exact manufacturer-recommended geometry. Generic model 2.00 x 1.20 x 0.45 mm: width is 0.05 mm below exact nominal body. Approximate visualization only; use 1.25 mm nominal plus datasheet tolerances for mechanical clearance. Original unique draft package and evidence retained in private shared-reuse migration recovery storage. No prior Spec verification is transferred." (at 92.71 234.95 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(property "Rating Conditions" "Derate ambient power linearly above 70 C to zero at selected maximum film temperature. Terminal rating requires thermal design; not 0.75 W at 70 C ambient. Working-voltage limit at 402 kohm gives approximately 56 mW at 150 V. See datasheet curves and mode-specific stability limits." (at 92.71 234.95 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(property "Legacy Comparison" "Historical 402 kohm, 0.1%, 25 ppm/C and 0805 match. 150 V rating exceeds historical 100 V. P70 modes exceed 125 mW thermally, but 125 mW at 402 kohm would require 224 V and is not permissible under 150 V limit. No inherited qualification or substitute approval." (at 92.71 234.95 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(property "Package Detail" "0805 (2012 Metric)" (at 92.71 234.95 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(property "Resistor Technology" "thin film" (at 92.71 234.95 0) (effects (font (size 1.27 1.27)) (hide yes)))
