		(property "Manufacturer 1" "Vishay Dale" (at 92.71 250.19 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(property "Manufacturer Part Number 1" "TNPW0805100KBEEA" (at 92.71 250.19 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(property "Part Origin" "Exact-MPN symbol created by Steve. Reuses the unchanged reviewed OCPM managed R_0805_2012Metric footprint and generic model under the standard passive-package exception. Vishay TNPW 0805 nominal body 2.00 x 1.25 x 0.45 mm; two nonpolar terminals. Shared IPC-style lands 1.025 x 1.40 mm at X +/-0.9125 mm, gap 0.80 mm. Vishay 28950 recommends 0.90 x 1.45 mm lands with 1.00 mm gap. Existing reviewed generic 0805 package selected; dimensional differences remain visible for exact-part assembly review. Generic model 2.00 x 1.20 x 0.45 mm has a 0.05 mm nominal width difference. It is not an exact manufacturing/clearance model; use the exact body and tolerances in the retained datasheet. Original unique draft package and evidence retained in private shared-reuse migration recovery storage. No prior Spec verification is transferred." (at 92.71 250.19 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(property "Resistance" "100 kohm" (at 92.71 250.19 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(property "Terminal Temperature Power Rating" "0.75 W at terminal part temperature 105 degC; application thermal management required" (at 92.71 250.19 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(property "Power Rating Conditions" "70 °C ambient, general mode; film ≤125 °C; derating applies" (at 92.71 250.19 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(property "Voltage Rating" "150 V maximum operating voltage, AC RMS or DC; power and voltage limits both apply" (at 92.71 250.19 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(property "Operating Temperature" "-55 to +175 degC advanced; general upper limit +125 degC, power upper limit +155 degC" (at 92.71 250.19 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(property "Ordering" "TNPW0805 / 100K / B / E / EA; EA lead-free paper tape, 5000 pieces; standard special suffix blank" (at 92.71 250.19 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(property "Historical Requirement Comparison" "Historical 100 kohm, +/-0.1%, +/-25 ppm/degC and 0805 match. Actual maximum voltage is 150 V, not historical 100 V. Actual P70 is operating-mode-dependent (0.140/0.220/0.260 W), not a copied 0.125 W rating. 0.75 W is conditional on terminal temperature, not ambient. No inherited qualification or substitute approval." (at 92.71 250.19 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(property "Package Detail" "0805 (2012 Metric); nominal 2.00 x 1.25 x 0.45 mm" (at 92.71 250.19 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(property "Resistor Technology" "thin film" (at 92.71 250.19 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(property "Power Rating Detail" "P70: 0.140 W general / 0.220 W power / 0.260 W advanced operation; ambient 70 degC" (at 92.71 250.19 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(property "Power Rating Conditions Detail" "Permissible film temperatures: general 125 degC, power 155 degC, advanced 175 degC. P70 is not a terminal-temperature rating. Apply manufacturer derating curves and safeguard assembled thermal resistance; see Vishay 28758 pages 1, 2 and derating diagrams." (at 92.71 250.19 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(property "Additional Power Ratings" "220/260 mW at 70 °C ambient with film ≤155/175 °C (power/advanced modes); 750 mW at 105 °C terminal, thermally conditional; manufacturer derating applies" (at 92.71 250.19 0) (effects (font (size 1.27 1.27)) (hide yes)))
	)
