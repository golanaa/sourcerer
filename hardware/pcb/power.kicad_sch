		(property "Operating Temperature" "-55 to +125 C" (at 120.65 245.11 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(property "Capacitance Measurement" "Room temperature; 1 kHz +/-10%; 1.0 +/-0.2 Vrms (spec p.2)" (at 120.65 245.11 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(property "Temperature Characteristic" "+/-15% relative to 25 C over -55 to +125 C; no bias" (at 120.65 245.11 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(property "DC Bias Limitation" "Effective capacitance decreases with DC bias; exact bias curve not provided by this reference. 1uF is not guaranteed at application DC voltage. AC peak plus DC must remain within rated voltage." (at 120.65 245.11 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(property "Legacy Comparison" "Nominal 1uF,25V,X7R,+/-10%,0805 agree with legacy context; no controller qualification, effective-capacitance guarantee, or substitute approval inherited." (at 120.65 245.11 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(property "Part Origin" "Exact-MPN symbol created by Steve. Reuses the unchanged reviewed OCPM managed C_0805_2012Metric footprint and generic model under the standard passive-package exception. Murata GRM21B nominal body 2.00 x 1.25 x 1.25 mm; unpolarized two end terminals. Retained IPC-style lands are 1.00 x 1.45 mm at X +/-0.95 mm (0.90 mm gap). Murata p26 recommends 0.6-0.8 x 1.2-1.4 mm lands with 1.2 mm gap. The shared footprint uses wider lands with the same 1.90 mm nominal pitch as the manufacturer-range midpoint. Selected as the existing reviewed generic 0805 package, not represented as an exact copy of Murata recommended geometry; assembly choice remains visible for exact-part review. Existing generic model bounding box 2.00 x 1.25 x 1.25 mm agrees with nominal body; idealized terminals and no internal construction. Original unique draft package and evidence retained in private shared-reuse migration recovery storage. No prior Spec verification is transferred." (at 120.65 245.11 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(property "Package Detail" "0805 (2012 Metric)" (at 120.65 245.11 0) (effects (font (size 1.27 1.27)) (hide yes)))
