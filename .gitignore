# Working source is eligible for Git; private notes and editor artifacts stay local.
/*
!/.gitignore
!/README.md
!/firmware/
!/hardware/
/firmware/*
!/firmware/.gitkeep
!/firmware/*.ioc
/hardware/*
!/hardware/.gitkeep
!/hardware/README.md
!/hardware/pcb/
/hardware/pcb/*
!/hardware/pcb/*.kicad_sch
!/hardware/pcb/*.kicad_pcb
!/hardware/pcb/*.kicad_pro
!/hardware/pcb/sym-lib-table
!/hardware/pcb/fp-lib-table
# Component libraries live in the separate sibling checkout, never in this repo.
/hardware/libs/
/hardware/published/
